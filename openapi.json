  "components": {
    "schemas": {
      "AccountIn": {
        "properties": {
          "bankId": {
            "type": "string",
            "title": "Bankid",
            "examples": [
              "999"
            ]
          },
          "accountNumber": {
            "type": "string",
            "title": "Accountnumber",
            "examples": [
              "DEMO1"
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "bankId",
          "accountNumber"
        ],
        "title": "AccountIn"
      },
      "AccountPatch": {
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "reviewStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unreviewed",
                  "under_review",
                  "cleared",
                  "escalated"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewstatus"
          }
        },
        "type": "object",
        "title": "AccountPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TransactionIn": {
        "properties": {
          "fromAccountId": {
            "type": "string",
            "title": "Fromaccountid",
            "examples": [
              "999_DEMO1"
            ]
          },
