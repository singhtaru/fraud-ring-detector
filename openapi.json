{
  "openapi": "3.1.0",
  "info": {
    "title": "Fraud Ring Detector API",
    "description": "Graph-based money-laundering ring detection on IBM AML HI-Small (Neo4j). Full-graph detection is precomputed into :Detection nodes; searches anchored on one account run live.",
    "version": "0.3.0"
  },
