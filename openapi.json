    "/rings": {
      "get": {
        "tags": [
          "Rings"
        ],
        "summary": "Stored detections, ranked by their members' risk",
        "operationId": "list_rings_rings_get",
        "parameters": [
          {
            "name": "method",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "cycles_time_amount"
              ],
              "title": "Method"
            }
          },
          {
            "name": "target",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "CYCLE"
              ],
              "title": "Target"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "avgRisk",
                "maxRisk",
                "size"
              ],
              "type": "string",
              "default": "avgRisk",
              "title": "Sort By"
            }
          },
          {
            "name": "min_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 2,
              "title": "Min Size"
            }
          },
          {
            "name": "matched_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only rings matching a labelled pattern (Jaccard >= 0.5)",
              "default": false,
              "title": "Matched Only"
            },
            "description": "Only rings matching a labelled pattern (Jaccard >= 0.5)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 25,
